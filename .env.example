# Project Settings
PROJECT_NAME="Enterprise RAG Platform"
ENVIRONMENT="development"
API_V1_STR="/api/v1"

# Database
DATABASE_URL="postgresql+asyncpg://erag_user:erag_password@postgres:5432/erag_db"
TEST_DATABASE_URL="postgresql+asyncpg://erag_test:erag_test@postgres_test:5432/erag_test_db"

# Redis
REDIS_URL="redis://redis:6379/0"

# Qdrant
QDRANT_HOST="qdrant"
QDRANT_PORT=6333
QDRANT_API_KEY=""
QDRANT_COLLECTION="documents"

# Storage
STORAGE_PATH="/app/storage"
STORAGE_PROVIDER="LOCAL" # or S3/MINIO

# Authentication
SECRET_KEY="YOUR_SUPER_SECRET_KEY_CHANGE_ME_IN_PRODUCTION"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 hours

# LLM & Embeddings
OPENAI_API_KEY=""
LLM_PROVIDER="openai" # or openrouter
EMBEDDING_PROVIDER="local" # or openai
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"
EMBEDDING_DIMENSION=384
RERANKER_MODEL="BAAI/bge-reranker-large"
