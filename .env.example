# Project Settings
PROJECT_NAME="Enterprise RAG Platform"
ENVIRONMENT="development"
API_V1_STR="/api/v1"

# Database
DATABASE_URL="postgresql+asyncpg://erag_user:erag_password@postgres:5432/erag_db"
TEST_DATABASE_URL="postgresql+asyncpg://erag_test:erag_test@postgres_test:5432/erag_test_db"

# Redis
REDIS_URL="redis://redis:6379/0"

# Qdrant Vector Database
QDRANT_HOST="qdrant"
QDRANT_PORT=6333
QDRANT_API_KEY=""
QDRANT_COLLECTION="documents"

# Storage
STORAGE_PATH="/app/storage"
STORAGE_PROVIDER="LOCAL" # or S3/MINIO

# Authentication & Security
SECRET_KEY="YOUR_SUPER_SECRET_KEY_CHANGE_ME_IN_PRODUCTION"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 hours

# Embedding Settings
EMBEDDING_PROVIDER="local" # "local" or "openai"
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"
EMBEDDING_DIMENSION=384
RERANKER_MODEL="BAAI/bge-reranker-large"

# LLM Providers & Resilient Multi-Provider Fallback Chain
# Options: "fallback", "ollama", "groq", "huggingface", "nvidia", "cloudflare", "pollinations", "openai", "fake"
LLM_PROVIDER="fallback"

# 1. Ollama Cloud
OLLAMA_API_KEY=""
OLLAMA_BASE_URL="https://ollama.com/api/chat"
OLLAMA_MODEL="gpt-oss:20b"

# 2. Groq
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# 3. Hugging Face Router
HUGGINGFACE_API_KEY=""

# 4. NVIDIA NIM
NVIDIA_API_KEY=""

# 5. Cloudflare Workers AI
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""

# 6. OpenAI
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
